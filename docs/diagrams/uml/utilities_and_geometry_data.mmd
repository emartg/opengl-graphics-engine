---
config:
  fontFamily: "Segoe UI, Arial, sans-serif"
  theme: base
  themeVariables:
    fontSize: 16px
    lineColor: "#44546a"
    edgeLabelBackground: "#ffffff"
---
%% Modules: Core (utilities, geometry, and the header data of the renderer and the lights) and App (CUBE.h and PLANE.h). Belongs to
%% architecture_overview (the block "Utilities and Geometry Data"). Mermaid cannot lay out unrelated classes of a class diagram in a
%% grid (it stacks them in one row or one column), so the class blocks are drawn in a block diagram, with the compartments of a UML
%% class (name with stereotype, attributes, operations) and a last compartment with the classes that use it; the dependencies
%% between these classes are the two dotted arrows.
block-beta
    columns 4

    FS("<i>&laquo;utility&raquo;</i><br/><b>File_System_Utils</b><hr/><div align='left'><u>+get_executable_directory() : path</u><br/><u>+find_first_existing_directory() : path</u></div><hr/><div align='left'><i>used by:</i> Core</div>") Rnd("<i>&laquo;utility&raquo;</i><br/><b>Random</b><hr/><div align='left'>-engine : mt19937</div><hr/><div align='left'>+generate_random_float(min, max) : float<br/>+generate_random_color() : vec4<br/>+generate_random_position(...) : vec3<br/>+generate_random_rotation(...) : quat<br/>+generate_random_direction() : vec3</div><hr/><div align='left'><i>used by:</i> GUI, the scenes</div>") Str("<i>&laquo;utility&raquo;</i><br/><b>String_Utils</b><hr/><div align='left'><u>+to_uppercase(text) : string</u><br/><u>+to_lowercase(text) : string</u><br/><u>+get_file_extension(path) : string</u><br/><u>+to_clean_display_name(name) : string</u><br/><u>+is_glsl_identifier(text) : bool</u></div><hr/><div align='left'><i>used by:</i> Material, Material_Library,<br/>Shader_Library, GUI, the scenes</div>") Pre("<i>&laquo;utility&raquo;</i><br/><b>Shader_Preprocessor</b><hr/><div align='left'><u>+load(path) : Shader_Source</u></div><hr/><div align='left'><i>used by:</i> Shader</div>")
    Fr("<i>&laquo;geometry&raquo;</i><br/><b>Frustum</b><hr/><div align='left'>-planes : array of 6 vec4</div><hr/><div align='left'>+intersects(box) : bool<br/>+contains(point) : bool</div><hr/><div align='left'><i>used by:</i> Renderer</div>") space BB("<i>&laquo;geometry&raquo;</i><br/><b>Bounding_Box</b><hr/><div align='left'>-min_corner : vec3<br/>-max_corner : vec3</div><hr/><div align='left'>+is_valid() : bool<br/>+expand(point or box)<br/>+transformed(matrix) : Bounding_Box</div><hr/><div align='left'><i>used by:</i> Node, Mesh, Mesh_Geometry,<br/>Renderer</div>") AD("<i>&laquo;header data&raquo;</i><br/><b>App data headers</b><hr/><div align='left'>CUBE.h<br/>PLANE.h</div><hr/><div align='left'><i>used by:</i> GUI, the scenes</div>")
    Ln("<i>&laquo;gizmo primitive&raquo;</i><br/><b>Line</b><hr/><div align='left'>-vertices : vector of float</div><hr/><div align='left'>+draw()<br/>+update_vertices(vertices)<br/>+deallocate_resources()</div><hr/><div align='left'><i>used by:</i> Directional_Light</div>") space GD("<i>&laquo;header data&raquo;</i><br/><b>Gizmo data headers</b><hr/><div align='left'>TRIANGLE_FAN_PLANE.h<br/>DECAHEDRON.h<br/>HEX_PYRAMID.h</div><hr/><div align='left'><i>used by:</i> the three lights, Line</div>") CD("<i>&laquo;header data&raquo;</i><br/><b>Core data headers</b><hr/><div align='left'>SKYBOX.h<br/>SCREEN_QUAD.h</div><hr/><div align='left'><i>used by:</i> Renderer</div>")

    Fr-. "tests" .->BB
    Ln-. "default vertices" .->GD

    classDef umlClass fill:#fff4dd,stroke:#eedebb,color:#333333
    class FS,Rnd,Str,Pre,Fr,BB,AD,Ln,GD,CD umlClass
