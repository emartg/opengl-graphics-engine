%% Modules: Core (utilities, geometry, and the header data of the renderer and the lights) and App (CUBE.h and PLANE.h). Belongs to
%% architecture_overview (the box "Utilities"). The relations are written on each card ("used by"), not drawn.
block-beta
    columns 4

    FS("<b>File_System_Utils</b><br/><i>utility</i><br/>get_executable_directory()<br/>find_first_existing_directory()<br/><i>used by Core</i>") Rnd("<b>Random</b><br/><i>utility</i><br/>generate_random_float()<br/>generate_random_color()<br/>generate_random_position()<br/>generate_random_rotation()<br/><i>used by GUI, the scenes</i>") Str("<b>String_Utils</b><br/><i>utility</i><br/>to_uppercase(), to_lowercase()<br/>get_file_extension()<br/>to_clean_display_name()<br/>is_glsl_identifier()<br/><i>used by Material, Material_Library,</i><br/><i>Shader_Library, GUI, the scenes</i>") Pre("<b>Shader_Preprocessor</b><br/><i>utility</i><br/>load(path) : Shader_Source<br/>resolves #include<br/><br/><i>used by Shader</i>")
    BB("<b>Bounding_Box</b><br/><i>geometry</i><br/>is_valid(), expand()<br/>transformed(matrix)<br/><br/><i>used by Node, Mesh,</i><br/><i>Mesh_Geometry, Renderer</i>") Fr("<b>Frustum</b><br/><i>geometry</i><br/>intersects(Bounding_Box)<br/>contains(point)<br/><br/><i>used by Renderer</i>") Ln("<b>Line</b><br/><i>gizmo primitive</i><br/>draw()<br/>update_vertices()<br/>default: TRIANGLE_FAN_PLANE.h<br/><i>used by Directional_Light</i>") space
    CD("<b>Core data headers</b><br/><i>header data</i><br/>SKYBOX.h<br/>SCREEN_QUAD.h<br/><br/><i>used by Renderer</i>") GD("<b>Gizmo data headers</b><br/><i>header data</i><br/>TRIANGLE_FAN_PLANE.h<br/>DECAHEDRON.h<br/>HEX_PYRAMID.h<br/><i>used by the three lights</i>") AD("<b>App data headers</b><br/><i>header data</i><br/>CUBE.h<br/>PLANE.h<br/><br/><i>used by GUI, the scenes</i>") space

    classDef utility fill:#e8f4e8,stroke:#388e3c,color:#1f2d3d
    classDef geometry fill:#d9eaf7,stroke:#1f4e79,color:#1f2d3d
    classDef data fill:#fff1dc,stroke:#d97706,color:#1f2d3d
    class FS,Rnd,Str,Pre utility
    class BB,Fr,Ln geometry
    class CD,GD,AD data
