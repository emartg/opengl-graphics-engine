---
config:
  layout: elk
  fontFamily: "Segoe UI, Arial, sans-serif"
  theme: base
  themeVariables:
    fontSize: 16px
    lineColor: "#44546a"
    edgeLabelBackground: "#ffffff"
  class:
    useMaxWidth: false
---
%% Overview of the engine as a UML class diagram: the modules (the stereotype of each block starts with its module: App, Platform, or Core)
%% and how they relate. The subsystem diagrams of this folder detail the blocks that group classes: managers_subsystem ("Managers and
%% Libraries"), rendering_and_gui_subsystem (Renderer, GLFW_Renderer, Gui_Layer, GUI, Assets_Window, and "Assets"),
%% scene_entities_subsystem ("Scene Entities"), and utilities_and_geometry_data ("Utilities and Geometry Data").
classDiagram
    direction LR
    class Application {
        <<App, entry point>>
        +main()
    }
    class GUI {
        <<App, GUI layer>>
        +configure()
        +draw()
    }
    class Assets_Window {
        <<App, window>>
        +draw(...)
    }
    class GLFW_Renderer {
        <<Platform, implementation>>
        +poll_io_events()
        +swap_buffers()
    }
    class Gui_Layer {
        <<Platform, interface>>
        +configure()
        +draw()*
    }
    class Core {
        <<Core, singleton>>
        -Renderer* renderer
        +get_instance()$ Core*
        +init() bool
        +run(max_frames)
        +shutdown()
    }
    class Renderer {
        <<Core, abstract>>
        +frame_start_config()
        +render_scene()
        +frame_end_config()
    }
    class Managers_and_Libraries["Managers and Libraries"] {
        <<Core, subsystem>>
        Scene_Manager
        Node_Manager
        Selection_Manager
        Input_Manager
        Shader_Library
        Material_Library
    }
    class Scene_Entities["Scene Entities"] {
        <<Core, subsystem>>
        Node, Model, Light, Camera
        Shader, Texture, Mesh
    }
    class Assets {
        <<Core, subsystem>>
        Asset_Registry
        Asset_Selection
    }
    class Utilities["Utilities and Geometry Data"] {
        <<Core, subsystem>>
        Random, String_Utils
        File_System_Utils
        Bounding_Box, Frustum
        Line, header data
    }
    Application ..> GLFW_Renderer : creates
    Application ..> GUI : creates
    Application --> Core : initializes, runs
    Core *-- Renderer : owns
    Core *-- Managers_and_Libraries : owns
    Core ..> Utilities : uses
    GLFW_Renderer --|> Renderer
    GLFW_Renderer *-- Gui_Layer : owns
    GUI ..|> Gui_Layer
    GUI *-- Assets_Window : owns
    Assets_Window *-- Assets : owns
    Renderer ..> Scene_Entities : draws
    GUI ..> Managers_and_Libraries : edits
    Managers_and_Libraries o-- Scene_Entities : holds
